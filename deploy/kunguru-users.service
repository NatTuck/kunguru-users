# systemd USER unit for kunguru-users.
# Install (as the kunguru user):
#   install -d ~/.config/systemd/user
#   cp deploy/kunguru-users.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   loginctl enable-linger kunguru        # start user services at boot
#   systemctl --user enable --now kunguru-users
# First-boot admin password: journalctl --user -u kunguru-users
#
# The app runs as the user that owns this unit (kunguru). It has no built-in
# instance defaults: ~/.config/kunguru-users.env MUST exist and set
# KUNGURU_INSTANCE=<name> (see deploy/instances/<name>.json), or the service
# exits. See deploy/kunguru-users.env.example.

[Unit]
Description=Kunguru user management app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/apps/kunguru-users
EnvironmentFile=%h/.config/kunguru-users.env
ExecStart=%h/.local/bin/mise exec -- pnpm start
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target

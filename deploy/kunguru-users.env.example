# Instance config for the kunguru-users systemd user unit.
# Copy to /home/kunguru/.config/kunguru-users.env and adjust per machine.
# This file is OUTSIDE the git checkout (instance-specific, per AGENTS.md).

# Runtime
NODE_ENV=production
PORT=3030
HOST=127.0.0.1

# Hosts the app provisions onto (inventory ssh_target overrides; host keys are
# the seeded names "otter.ferrus.net" / "goose.ferrus.net").
# otter kunguru reaches otter via loopback and goose over the WireGuard LAN.
KUNGURU_SSH_OTTER_FERRUS_NET=localhost
KUNGURU_SSH_GOOSE_FERRUS_NET=10.0.1.2

# Which seeded host runs Snikket (defaults to otter.ferrus.net).
# KUNGURU_SNIKKET_HOST=otter.ferrus.net

# Bifrost LLM gateway (provisioning issues a per-user virtual key per account).
# Defaults match the kunguru hub: admin API on the loopback of the app host and
# the public agent endpoint / model / XMPP domain below.
# BIFROST_API_URL=http://127.0.0.1:8181
# BIFROST_ADMIN_USERNAME=admin          # overrides reading /etc/bifrost/env
# BIFROST_ADMIN_PASSWORD=...            # overrides reading /etc/bifrost/env
# BIFROST_PROVIDERS=deepseek            # providers a per-user key is scoped to
# HERMES_LLM_BASE_URL=https://llm.ironbeard.com/v1
# HERMES_MODEL=deepseek/flash           # Bifrost model alias (provider/alias)
# XMPP_DOMAIN=chat.ironbeard.com

# Per-user sites (Hermes WebUI / private app / public site) reverse-proxied by
# the gateway's nginx. Set BASE_DOMAIN to the public DNS base; per-user hosts
# are derived (see server/sites.ts):
#   <user>-hermes.users.<base>  hermes-webui  11000+id  private
#   <user>.users.<base>         private-app   13000+id  private
#   <user>.<base>               public-site   12000+id  public
# The session cookie defaults to the private subtree (users.<base>).
# KUNGURU_BASE_DOMAIN=ironbeard.com
# KUNGURU_ACME_EMAIL=nat@ferrus.net      # required to issue/renew the combined cert
# KUNGURU_GATEWAY_HOST=otter.ferrus.net  # host that runs nginx (default: snikket host)
# KUNGURU_SITES_CERT=kunguru-sites       # certbot --cert-name for the combined cert
# KUNGURU_COOKIE_DOMAIN=users.ironbeard.com

# Instance config for the kunguru-users systemd user unit.
# Copy to /home/kunguru/.config/kunguru-users.env and edit per machine.
# This file is OUTSIDE the git checkout (instance-specific, per AGENTS.md).
#
# The app has NO built-in instance defaults. Its deployment identity (domain,
# LLM gateway endpoint + providers + default model, XMPP domain, hosts, TLS) is
# read from a per-instance JSON file in the checkout:
#   deploy/instances/<instance>.json
# selected by KUNGURU_INSTANCE below. If that file (or a required field) is
# missing the service refuses to start — it will never fall back to another
# deployment's endpoints. This env file only selects the instance and carries
# secrets / process settings (e.g. NODE_ENV).

# REQUIRED: which per-instance config to load (deploy/instances/<name>.json).
KUNGURU_INSTANCE=kunguru.net
# Alternative: an explicit path to the instance JSON (wins over KUNGURU_INSTANCE).
# KUNGURU_CONFIG=/path/to/instance.json

# Runtime lives in the instance JSON ("runtime": {"port": 3030, "host":
# "127.0.0.1"}). PORT/HOST in this file are NOT read.
NODE_ENV=production

# Secrets stay out of the repo. Bifrost admin credentials are read from
# /etc/bifrost/env on the gateway host, or overridden here:
# BIFROST_ADMIN_USERNAME=admin
# BIFROST_ADMIN_PASSWORD=...

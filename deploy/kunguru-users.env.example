# Instance config for the kunguru-users systemd user unit.
# Copy to /home/kunguru/.config/kunguru-users.env and adjust per machine.
# This file is OUTSIDE the git checkout (instance-specific, per AGENTS.md).

# Runtime
NODE_ENV=production
PORT=3030
HOST=127.0.0.1

# Hosts the app provisions onto (inventory ssh_target overrides; host keys are
# the seeded names "otter.ferrus.net" / "goose.ferrus.net").
# otter kunguru reaches otter via loopback and goose over the WireGuard LAN.
KUNGURU_SSH_OTTER_FERRUS_NET=localhost
KUNGURU_SSH_GOOSE_FERRUS_NET=10.0.1.2

# Which seeded host runs Snikket (defaults to otter.ferrus.net).
# KUNGURU_SNIKKET_HOST=otter.ferrus.net

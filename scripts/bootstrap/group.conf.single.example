# kunguru bootstrap inventory — single host (all roles on one machine).
#
# Copy to `group.conf` (gitignored) and edit. No secrets live here.
#
# With exactly one host, bootstrap skips the WireGuard steps (there are no
# peers); nginx, Snikket, and Bifrost all run on the same machine. See
# notes/topology.md §2.2.

BOOTSTRAP_SSH_USER="kunguru"
# Sudo-capable account this controller can already reach (used once by the
# ssh-access step). Leave empty to skip that step and authorize keys yourself.
INIT_SSH_USER=""
CONTROLLER_SSH_KEY="${HOME}/.ssh/id_ed25519.pub"

# Public gateway facts.
PUBLIC_IP="203.0.113.10"
PUBLIC_FQDN="solo.example.net"

# No VPN: there is nothing to connect to.
SKIP_WIREGUARD=1
WG_IFACE="wg0"          # unused, kept so the nginx step has a value
WG_HUB_IP=""
WG_SUBNET=""
WG_PORT=""
WG_NAT_IFACE=""
WG_PEER_DEFAULT_GATEWAY="0"

# --- Snikket (same host) ---
SNIKKET_HOST="solo"
SNIKKET_DOMAIN="chat.solo.example.net"
SNIKKET_ADMIN_EMAIL=""
SNIKKET_TWEAK_HTTP_PORT="5080"
SNIKKET_TWEAK_HTTPS_PORT="5443"

# --- Bifrost (same host) ---
BIFROST_HOST="solo"
BIFROST_DOMAIN="llm.solo.example.net"
BIFROST_PORT="8181"
BIFROST_CORS_ORIGINS="https://*.solo.example.net"

# --- Host roles: exactly one hub ---
declare -A HOST_ROLES=(
  ["solo"]="hub"
)

declare -A HOST_SSH=(
  ["solo"]="solo.example.net"
)
